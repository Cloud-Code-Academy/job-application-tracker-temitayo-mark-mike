<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__Tab</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Job_Application__c</object>
                <object>Interview_Feedback__c</object>
            </objects>
        </targetConfig>
        <targetConfig targets="lightning__AppPage,lightning__HomePage,lightning__Tab,lightningCommunity__Page,lightningCommunity__Default">
            <property name="jobApplicationId" type="String" label="Job Application ID" description="ID of the Job Application to create feedback for"/>
            <property name="interviewType" type="String" label="Default Interview Type" description="Pre-select interview type for quick entry"/>
            <property name="enableOfflineMode" type="Boolean" default="true" label="Enable Offline Mode" description="Allow feedback capture when offline"/>
            <property name="enableVoiceMemos" type="Boolean" default="true" label="Enable Voice Memos" description="Allow voice memo recording"/>
            <property name="enablePhotoAttachments" type="Boolean" default="true" label="Enable Photo Attachments" description="Allow photo attachments"/>
            <property name="enableLocationCapture" type="Boolean" default="false" label="Enable Location Capture" description="Capture GPS location (requires user permission)"/>
            <property name="maxPhotos" type="Integer" default="5" label="Max Photos" description="Maximum number of photos allowed"/>
            <property name="maxVoiceMemoLength" type="Integer" default="300" label="Max Voice Memo Length (seconds)" description="Maximum voice memo duration in seconds"/>
        </targetConfig>
    </targetConfigs>
    <masterLabel>Mobile Feedback Capture</masterLabel>
    <description>Mobile-optimized component for capturing interview feedback with touch gestures, voice memos, and offline capabilities</description>
</LightningComponentBundle>