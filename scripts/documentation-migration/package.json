{
  "name": "salesforce-documentation-migrator",
  "version": "1.0.0",
  "description": "Automated tool to migrate markdown documentation to Salesforce Knowledge Base",
  "main": "dist/index.js",
  "bin": {
    "sf-doc-migrate": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:performance": "jest --selectProjects performance",
    "test:watch": "jest --watch",
    "test:coverage": "COLLECT_COVERAGE=true jest --coverage",
    "test:coverage:unit": "COLLECT_COVERAGE=true jest --selectProjects unit --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:verbose": "VERBOSE_TESTS=true jest --verbose",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rimraf dist coverage test-results",
    "prepare": "npm run clean && npm run build",
    "test:salesforce": "jest --selectProjects integration --testNamePattern='Salesforce'"
  },
  "keywords": [
    "salesforce",
    "knowledge-base",
    "documentation",
    "migration",
    "markdown"
  ],
  "author": "Job Application Tracker Team",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^9.4.1",
    "dotenv": "^16.3.1",
    "joi": "^17.11.0",
    "jsforce": "^2.0.0-beta.29",
    "markdown-it": "^13.0.2",
    "ora": "^5.4.1",
    "winston": "^3.11.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/markdown-it": "^13.0.7",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}