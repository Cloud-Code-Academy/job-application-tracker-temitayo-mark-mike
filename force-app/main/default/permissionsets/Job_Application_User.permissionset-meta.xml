<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Standard user access to Job Applications with limited administrative capabilities</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Job Application User</label>
    
    <!-- Object Permissions - Limited Access -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Job_Application__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    
    <!-- Field Permissions - Standard Access -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Job_Application__c.Company_Name__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Job_Application__c.Position_Title__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Job_Application__c.Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Job_Application__c.Salary__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Job_Application__c.Location__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Job_Application__c.Application_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Job_Application__c.Notes__c</field>
        <readable>true</readable>
    </fieldPermissions>
    
    <!-- Tax Fields - Read Only for Users -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Job_Application__c.Federal_Tax__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Job_Application__c.Social_Security_Tax__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Job_Application__c.Medicare_Tax__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Job_Application__c.Take_Home_Pay_Yearly__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Job_Application__c.Take_Home_Pay_Monthly__c</field>
        <readable>true</readable>
    </fieldPermissions>
    
    <!-- Contact Field - Limited Access -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Job_Application__c.Primary_Contact__c</field>
        <readable>true</readable>
    </fieldPermissions>
    
    <!-- Apex Class Access - Limited -->
    <classAccesses>
        <apexClass>SalaryCalculationService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ApplicationAnalyticsService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    
    <!-- Tab Access -->
    <tabSettings>
        <tab>Job_Application__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>